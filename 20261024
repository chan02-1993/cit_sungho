"import java.io.*;
import java.util.stream.IntStream;
import java.util.*;
import java.util.Arrays;

public class Main {
        static BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        static BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));
        static StringTokenizer st;

    public static void main(String[] args) throws IOException
    {
                        
            st = new StringTokenizer(br.readLine());
            int N = Integer.parseInt(st.nextToken());
            
            int[][] swaps = new int[N][2];
            int[] elsie_guess = new int[N];
            
            for (int x=0; x<N; x++) 
            {
                    
                    st = new StringTokenizer(br.readLine());
                    swaps[x][0] = Integer.parseInt(st.nextToken())-1;
                    swaps[x][1] = Integer.parseInt(st.nextToken())-1;
                    elsie_guess[x] = Integer.parseInt(st.nextToken())-1;
                    
            }
                        
            boolean[] has_pebble = new boolean[3];
            int max = 0;
            
            for (int x=0; x<3; x++)
            {
                    
                    has_pebble[0] = false;
                    has_pebble[1] = false;
                    has_pebble[2] = false;
                    has_pebble[x] = true;
                                        
                int elsie_score = 0;

                    for (int y=0; y<N; y++) 
                    {
                            
                            boolean temp=has_pebble[swaps[y][0]];
                            has_pebble[swaps[y][0]]=has_pebble[swaps[y][1]];
                            has_pebble[swaps[y][1]]=temp;
                            
                            if (has_pebble[elsie_guess[y]]) elsie_score++;
                            
                            
                    }
                    
                    if (elsie_score>max) max=elsie_score;
                    
            }
            
            System.out.println(max+"""");
            
    }   

}
    
