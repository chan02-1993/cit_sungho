"import java.io.*;
import java.util.stream.IntStream;
import java.util.*;
import java.util.Arrays;

public class Main {
        static BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        static BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));
        static StringTokenizer st;

    public static void main(String[] args) throws IOException
    {
                        
        
        st = new StringTokenizer(br.readLine());       
        int N = Integer.parseInt(st.nextToken());
                
        //[""name"", ""previous_or_next"", ""zodiac_value"", ""cow_value""]
        
        String[][] Cow_Value = new String[N+1][2];

        for (int x=1; x<N+1; x++) 
            {
            	st = new StringTokenizer(br.readLine());
                //자축인묘진사오미신유술해 쥐 소 호랑이 토끼 용 뱀 말 양 원숭이 닭 개 돼
            	//Mildred (Name) born in previous (Direction) Dragon (Zodiac) year from Bessie (Comparison)
                String Name = st.nextToken();
                Cow_Value[x][0]=Name;
                st.nextToken();
                st.nextToken();
                String Direction = st.nextToken();
                String Zodiac = st.nextToken();
                st.nextToken();
                st.nextToken();
                String Comparison = st.nextToken();
                
                String[] Zodiac_List = {""Ox"", ""Tiger"", ""Rabbit"", ""Dragon"", ""Snake"", ""Horse"", ""Goat"", ""Monkey"", ""Rooster"", ""Dog"", ""Pig"", ""Rat""};
                                
                Cow_Value[0][0]=""Bessie"";
                Cow_Value[0][1]=""0"";
                int Cow_Age = 0;
                int Comparator_Age=0;
                
                for (int y=0; y<x+1; y++) 
                {
                	
                	if (Comparison.equals(Cow_Value[y][0])) 
                	{
                		
                		Comparator_Age=Integer.parseInt(Cow_Value[y][1]);
                		
                	}
                	
                }
                
                int Interval=1;
                int Interval_Increment=1;
                if (Direction.equals(""previous"")) 
                {
                	
                	Interval=-1;
                	Interval_Increment=-1;
                	
                }
                
                while (true) 
                {
                	
                	if (Zodiac_List[(Comparator_Age+1212+Interval)%12].equals(Zodiac)) 
                	{
                		
                		Cow_Age=Comparator_Age+Interval;
                		break;
                		
                	}
                	
                	Interval+=Interval_Increment;
                	
                }
                
                Cow_Value[x][1]=Cow_Age+"""";
                                

        }
        
        String ans="""";
        for (int x=0; x<N+1; x++) 
        {
        	
        	if (Cow_Value[x][0].equals(""Elsie"")) ans=Math.abs(Integer.parseInt(Cow_Value[x][1]))+"""";
        	
        }
        
        bw.write(ans);
        bw.flush();
            
    }       

            
