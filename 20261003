public class Main {
        static BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        static BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));
        static StringTokenizer st;

    public static void main(String[] args) throws IOException
    {
                        
            st = new StringTokenizer(br.readLine());
            int N = Integer.parseInt(st.nextToken());
            int[][] Coordinates = new int[N][2];
            
            for (int x=0; x<N; x++) 
            {
                    
                st = new StringTokenizer(br.readLine());
                    Coordinates[x][0] = Integer.parseInt(st.nextToken());
                    Coordinates[x][1] = Integer.parseInt(st.nextToken());
                    
            }
            
            int[] output = new int[N];
            for (int x=0; x<N; x++) 
            {
                    
                    output[x]=0;
                    
            }
            for (int z=0; z<N; z++)
            {
                    
                        for (int x=0; x<=z; x++) 
                        {
                                
                                int neighbor_count = 0;
                                for (int y=0; y<=z; y++) 
                                {
                                        if (x==y) continue;
                                        if (Coordinates[x][0]+1==Coordinates[y][0]&&Coordinates[x][1]==Coordinates[y][1]) neighbor_count++;
                                        else if (Coordinates[x][0]-1==Coordinates[y][0]&&Coordinates[x][1]==Coordinates[y][1]) neighbor_count++;
                                        else if (Coordinates[x][1]+1==Coordinates[y][1]&&Coordinates[x][0]==Coordinates[y][0]) neighbor_count++;
                                        else if (Coordinates[x][1]-1==Coordinates[y][1]&&Coordinates[x][0]==Coordinates[y][0]) neighbor_count++;
                                        
                                }
                                
                                if (neighbor_count==3) output[z]++;
                                
                        }
                        
            }
            
            for (int x=0; x<N; x++) System.out.println(output[x]);
            
    }
   
}
    
