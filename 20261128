        	st = new StringTokenizer(br.readLine());    

    		int recipie_number = Integer.parseInt(st.nextToken())-1;
    		int recipie_count = Integer.parseInt(st.nextToken());
    		
    		for (int y=0; y<recipie_count; y++)
