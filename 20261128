        		make_num(recipies.get(num).get(x));
    		
    		}
    		
    	}
    	
    	canmake = true;
    	for (int x=0; x<recipies.get(num).size(); x++)
    	{
    		
    		if (stock[recipies.get(num).get(x)]==0) 
    		{
    			
    			canmake=false;
    		
    		}
    		
    	}
    	
    	if (canmake==false) return false;
    	    		
    	for (int x=0; x<recipies.get(num).size(); x++) 
    	{
    			
    		stock[recipies.get(num).get(x)]--;
    			
    	}
    		
		stock[num]++;

		return true;
			    	
