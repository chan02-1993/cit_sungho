    			stock[recipies.get(num).get(x)]--;
    			
    		}
    		
			stock[num]++;

			return true;
			
    	}
    	    	
    	for (int x=0; x<recipies.get(num).size(); x++)
    	{
    		
    		if (stock[recipies.get(num).get(x)]==0) 
