    	for (int x=0; x<N; x++) 
    	{
    		
    		stock[x] = Integer.parseInt(st.nextToken());
    		
    	}
    	
    	st = new StringTokenizer(br.readLine());    
    	K = Integer.parseInt(st.nextToken());
    	
    	recipies = new ArrayList<ArrayList<Integer>>();
    	
    	for (int x=0; x<N; x++) 
